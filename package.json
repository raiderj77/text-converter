    "test:regressions": "node --test",
    "prebuild": "npm run lint:predeploy && npm run lint:content && npm run test:quality"
  },
  "dependencies": {
    "js-yaml": "5.2.2",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.3"
