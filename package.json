{
  "name": "text-case-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:content": "node scripts/content-lint.js",
    "lint:predeploy": "node scripts/predeploy-check.js",
